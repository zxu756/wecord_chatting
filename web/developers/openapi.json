    "/chats/{chat_id}/messages": {
      "get": {
        "summary": "Recent messages of a chat",
        "security": [
          {
            "botToken": []
          }
        ],
        "description": "In a chat with Advanced chat privacy the messages come without their text.",
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The id of a chat from GET /chats (a channel's id for a circle channel)."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "How many to return."
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Only messages before this time."
          }
        ],
        "responses": {
          "200": {
