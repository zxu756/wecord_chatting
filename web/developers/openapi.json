{
  "openapi": "3.0.3",
  "info": {
    "title": "WeCord bot API",
    "version": "2.0",
    "description": "Bots are member accounts that programs drive over HTTP. Every request sends `Authorization: Bot <token>`. Bodies are JSON (at most 32 KB); file uploads are multipart (at most 8 MB). At most 60 writes per minute per bot."
  },
  "servers": [
    {
      "url": "https://{project}.supabase.co/functions/v1/bot-api",
      "variables": {
        "project": {
          "default": "your-project"
        }
      }
    }
  ],
  "components": {
    "securitySchemes": {
      "botToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "`Bot <token>`; the token is shown once in Settings, Developer."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "circle_id": {
            "type": "string",
            "format": "uuid"
          },
          "circle_name": {
            "type": "string"
          }
        }
      },
      "Channel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "chat_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "can_send": {
            "type": "boolean"
          }
        }
      },
      "Chat": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "channel",
              "thread",
              "group",
              "direct"
            ]
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "member_count": {
            "type": "integer"
          },
          "restricted": {
            "type": "boolean",
            "description": "Advanced chat privacy is on: no message text."
          }
        }
      },
      "Person": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "is_bot": {
            "type": "boolean"
          }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "chat_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "nullable": true
          },
          "deleted": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "edited_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "reply_to_message_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "author": {
            "$ref": "#/components/schemas/Person"
          }
        }
      },
      "SendMessage": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 2000
          },
          "reply_to": {
            "type": "string",
            "format": "uuid"
          },
          "components": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      },
      "EditMessage": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 2000
          },
          "components": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      },
      "Poll": {
        "type": "object",
        "required": [
          "question",
          "options"
        ],
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 300
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "multiple": {
            "type": "boolean",
            "default": false
          },
          "duration_hours": {
            "type": "integer",
            "minimum": 1
          },
          "anonymous": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Thread": {
        "type": "object",
        "properties": {
          "chat_id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "root_message_id": {
            "type": "string",
            "format": "uuid"
          },
          "parent_chat_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Member": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "is_bot": {
            "type": "boolean"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "Event": {
        "type": "object",
        "description": "What WeCord POSTs to an event address.",
        "properties": {
          "version": {
            "type": "integer",
            "example": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "event"
            ]
          },
          "event": {
            "type": "string",
            "enum": [
              "message.created",
              "message.mentioned",
              "message.updated",
              "message.deleted",
              "reaction.added",
              "member.joined",
              "member.left",
              "interaction.created",
              "ping"
            ]
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "bot_id": {
            "type": "string",
            "format": "uuid"
          },
          "circle_id": {
            "type": "string",
            "format": "uuid"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  },
  "paths": {
    "/me": {
      "get": {
        "summary": "Who am I",
        "security": [
          {
            "botToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "The bot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
